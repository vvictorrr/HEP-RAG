# Copy this file to `.streamlit/secrets.toml` for local development.
# NEVER commit the real `.streamlit/secrets.toml` — it is already in .gitignore.
#
# For Streamlit Community Cloud deployment:
#   1. Go to your app's dashboard -> Settings -> Secrets
#   2. Paste the contents below with your real key substituted
#   3. Save — Streamlit Cloud injects these as st.secrets at runtime

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional: override the default model used for generation + judging
GENERATION_MODEL = "claude-sonnet-5"
